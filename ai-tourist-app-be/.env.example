# =============================================================================
# AI Tourist App - Backend .env.example
# =============================================================================

# Application
NODE_ENV=development
PORT=3000
API_PREFIX=/api

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/ai_tourist_app
DATABASE_SSL=false

# Redis
REDIS_URL=redis://localhost:6379

# JWT Secrets (generate with: openssl rand -hex 64)
JWT_ACCESS_SECRET=your_jwt_access_secret_here_min_32_chars
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here_min_32_chars

# Encryption Master Key (for sensitive data at rest)
ENCRYPTION_MASTER_KEY=your_32_byte_hex_encryption_key_here

# OAuth (Google)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3001

# Web Push
VAPID_EMAIL=mailto:your-email@example.com
VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here

# AI Provider API Keys (for validation)
OPENAI_API_KEY=sk-your_openai_key_here
ANTHROPIC_API_KEY=sk-ant-your_anthropic_key_here
GOOGLE_GENAI_API_KEY=your_google_genai_key_here
XAI_API_KEY=your_xai_key_here

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info
