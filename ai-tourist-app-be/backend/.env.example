# ── Backend env (copy to .env and fill in) ──────────────────────────────
# Server
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Postgres + PostGIS
# Used by pg Pool and the migrations runner.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ai_travel_guide

# Auth / JWT
# Generate with: openssl rand -base64 64
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
# Access tokens are short-lived (15 minutes). Refresh tokens rotate weekly
# (7 days). See design.md §8.4 for rationale.
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
BCRYPT_COST=12

# Key vault
# Server-side KEK is OPTIONAL. With client-side KEK (recommended, see design §8.1)
# the server never decrypts and this value is unused. Kept for the alternative
# server-side KMS scheme.
KEY_VAULT_KEK=change-me-kek

# AI provider validation endpoint (called once on key save to validate shape).
# OpenAI-compatible default. Override per-provider at runtime if needed.
AI_PROVIDER_BASE_URL=https://api.openai.com
AI_PROVIDER_VALIDATE_PATH=/v1/models
# ── Tourist spot POI integration (Sprint 2) ────────────────────────────
# Server-side Google Places API key for POI data (Nearby Search).
# This is a SERVER key for POI enrichment, NOT the user's AI key.
# Leave unset to disable Google Places sync; set WIKIDATA_FALLBACK_ENABLED=true
# to use the Wikidata SPARQL fallback instead.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACES_BASE_URL=https://places.googleapis.com

# Wikidata fallback — used when Google Places is unavailable or returns no
# results. Disabled by default; enable for zero-cost POI enrichment.
WIKIDATA_FALLBACK_ENABLED=false
WIKIDATA_SPARQL_ENDPOINT=https://query.wikidata.org/sparql

# ── CORS ────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins. Examples:
#   CORS_ALLOWED_ORIGINS=https://your-app.vercel.app,https://staging.your-app.com
#   CORS_ALLOWED_ORIGINS=*.your-app.com
# Empty in development => permissive (any origin, no credentials).
# Empty in production  => deny by default (cross-origin requests blocked).
CORS_ALLOWED_ORIGINS=